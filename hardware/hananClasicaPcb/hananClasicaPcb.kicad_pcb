	(footprint "ODS:Hanan_PadsArcade_1x08_Pares_Compacto"
		(layer "F.Cu")
		(uuid "a4c3489f-2606-4333-b464-9ddfa64e24cc")
		(at 120.7 102)
		(descr "Hanan Cumbia (clasica, version compacta): 8 pads para soldar los cables de los 4 botones arcade, en UNA columna, agrupados de a pares (senal arriba, GND abajo): 5 mm dentro del par; pares 1-2 arriba (paso 17, el LED D1 en el hueco) y pares 3-4 ESPEJADOS respecto del centro de la placa 150x75 (a 4.6 mm de cada borde); offsets 0/5, 13/18, 26/31, 39/44 (version COMPACTA, 44 mm, para la Hanan clasica 77x92 donde la de 66 mm no entra; mismo orden/numeracion/colores). Pad redondo 3.5 mm, agujero 1.3 mm (cable 22 AWG). NUMERACION = pines del simbolo J2 Conn_02x04_Top_Bottom del esquematico hananMiniPcb, en el MISMO orden de colores que el header original: slot1=pad1 (D3, BLANCO/cencerro) slot2=pad2 GND, slot3=pad4 (D8, ROSA/conga) slot4=pad3 GND, slot5=pad5 (D4, AMARILLO/kick) slot6=pad6 GND, slot7=pad8 (D7, VERDE/guiro) slot8=pad7 GND. Colores = botones del panel Mini (manual + firmware hanan26Taller, 2026-10-07). ORIGEN = centro del pad del slot 1 (arriba).")
		(tags "hanan arcade solder pads wire pads cable THT 1x08 pares")
